
# =================================================================
# FemCare AI - Environment Configuration
# =================================================================

# -----------------------------------------------------------------
# 1. DATABASE CONFIGURATION (MongoDB Atlas)
# -----------------------------------------------------------------
# Replace <username>, <password>, and <cluster-url> with your MongoDB Atlas details:
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>/femcare?retryWrites=true&w=majority

# -----------------------------------------------------------------
# 2. BACKEND CONFIGURATION (Render Web Service)
# -----------------------------------------------------------------
NODE_ENV=production

# Backend Server Port (Render automatically injects PORT, 5000 used locally)
PORT=5000

# JSON Web Token Secret (generate a strong random 64-char string)
JWT_SECRET=your_super_secret_jwt_key_here

# AI Service Keys (Groq / Google Gemini)
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Cloudinary Cloud Storage (for medical reports and document uploads)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# CORS Allowed Frontend URLs (Render Backend)
# Add your deployed Vercel domain here (e.g., https://femcare-ai.vercel.app)
CLIENT_URL=https://your-femcare-app.vercel.app

# -----------------------------------------------------------------
# 3. FRONTEND CONFIGURATION (Vercel Project Settings)
# -----------------------------------------------------------------
# Base URL for Express backend API (Used by React/Vite on Vercel)
# In development: leave empty or http://localhost:5000
# In production (Vercel): https://your-backend.onrender.com
VITE_API_URL=https://your-backend.onrender.com

# Optional WebSocket URL for real-time chat & video calls
# If omitted, it automatically uses the root domain of VITE_API_URL
VITE_SOCKET_URL=https://your-backend.onrender.com
