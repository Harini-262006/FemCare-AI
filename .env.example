
# MongoDB connection string (MongoDB Atlas cluster URI required for production deployment)
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/femcare?retryWrites=true&w=majority
MONGODB_URI=

# JWT Secret Key for authentication tokens
JWT_SECRET=your_jwt_secret_key_here

# AI Service API Keys
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_API_KEY=

# Cloudinary Credentials (for cloud storage of medical reports & attachments)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Production URLs for CORS configuration (Optional)
CLIENT_URL=https://your-femcare-app.vercel.app
FRONTEND_URL=

# Vite Frontend Environment Variables (Optional override, defaults to relative /api)
VITE_API_URL=
VITE_SOCKET_URL=

# Port for local backend server
PORT=5000
