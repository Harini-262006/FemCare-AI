
# MongoDB connection string (MongoDB Atlas cluster URI recommended for production)
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/femcare?retryWrites=true&w=majority

# JWT Secret Key for user & doctor authentication
JWT_SECRET=your_jwt_secret_key_here

# Groq AI API Key (for LLM Chat & Insights - https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# Google Gemini API Key (for Multimodal Vision & OCR Analysis)
GEMINI_API_KEY=your_gemini_api_key_here

# Cloudinary Credentials (for document & media upload persistence - https://console.cloudinary.com)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Production Frontend URL for CORS (Optional)
CLIENT_URL=https://your-femcare-app.vercel.app

# Optional Frontend Override Variables (Vite)
VITE_API_URL=
VITE_SOCKET_URL=

# Port for local backend server
PORT=5000
